{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.2finance.io/exchange/matchengine-order-response.v2.json",
  "title": "MatchEngine WebSocket command response v2",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "version", "message_type"],
  "properties": {
    "schema": {"const": "matchengine.order_response.v2"},
    "version": {"const": 2},
    "message_type": {"enum": ["ACK", "REJECT"]},
    "client_order_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128},
    "timestamp": {"type": "integer", "minimum": 0},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 128},
    "message": {"type": "string", "maxLength": 1024}
  },
  "allOf": [
    {
      "if": {"properties": {"message_type": {"const": "REJECT"}}, "required": ["message_type"]},
      "then": {"required": ["reason_code"]}
    },
    {
      "if": {"properties": {"message_type": {"const": "ACK"}}, "required": ["message_type"]},
      "then": {"required": ["client_order_id", "idempotency_key", "timestamp"]}
    }
  ]
}
